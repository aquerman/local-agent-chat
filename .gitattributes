# Force LF line endings for shell scripts and git hooks (required for cross-platform compatibility)
.husky/* text eol=lf
*.sh text eol=lf
# npm rewrites CRLF to LF in workspace bin scripts on install; keep them LF so a Windows
# checkout (core.autocrlf=true) doesn't show them as modified after every npm ci
packages/folders/src/index.mjs text eol=lf
